PORT=3001
MONGODB_URI=mongodb://localhost:27017/deckr
# Comma-separated list of origins allowed to call the API. Leave empty to allow any origin.
CORS_ORIGIN=
# Deckr's own Clash Royale developer key, allowed for this machine's public IP. Needed for the in-game token login.
CLASH_ROYALE_API_KEY=
# 32-byte key (base64 or hex) used to encrypt stored Clash Royale API tokens: `openssl rand -base64 32`.
# Leave empty to have one generated in DATA_DIR on first start.
TOKEN_SECRET=
DATA_DIR=.data
# Set to true when Deckr is served over HTTPS.
COOKIE_SECURE=false
