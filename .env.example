# Used by `docker compose up`.
WEB_PORT=8080
# Deckr's own Clash Royale developer key, allowed for this server's public IP (developer.clashroyale.com).
# Needed for players who log in with the token from the game's Settings → API Token. Leave empty to turn that off.
CLASH_ROYALE_API_KEY=
# 32-byte key that encrypts stored Clash Royale API tokens: `openssl rand -base64 32`.
# Leave empty to have one generated and kept in the api-data volume.
TOKEN_SECRET=
# Set to true when Deckr is served over HTTPS.
COOKIE_SECURE=false
# Public address, e.g. https://deckr.example.com. Used for canonical/hreflang URLs, the sitemap and robots.txt.
# Leave empty for local use: the site then asks search engines not to index it.
SITE_URL=
