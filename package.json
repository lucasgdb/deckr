{
   "name": "deckr",
   "version": "2.0.0",
   "description": "Deck Builder & Manager for Clash Royale",
   "repository": "git@github.com:lucasgdb/deckr.git",
   "author": "Lucas Bittencourt",
   "license": "MIT",
   "private": true,
   "type": "module",
   "packageManager": "pnpm@12.18.0",
   "engines": {
      "node": ">=24"
   },
   "scripts": {
      "dev": "pnpm --parallel --filter \"./apps/*\" dev",
      "dev:web": "pnpm --filter @deckr/web dev",
      "dev:api": "pnpm --filter @deckr/api dev",
      "build": "pnpm --filter @deckr/web build",
      "typecheck": "pnpm -r typecheck",
      "test": "pnpm --filter @deckr/web test",
      "check": "biome check .",
      "check:fix": "biome check --write .",
      "db": "docker compose up -d mongo"
   },
   "devDependencies": {
      "@biomejs/biome": "2.6.6",
      "typescript": "7.0.2"
   }
}
